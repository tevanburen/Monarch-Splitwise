{
	"name": "Monarch-Splitwise",
	"version": "2.0",
	"manifest_version": 3,
	"permissions": ["storage"],
	"background": {
		"service_worker": "dist/background.js"
	},
	"content_scripts": [
		{
			"js": ["dist/fetch-interceptor.js"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"js": ["dist/content.js"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["dist/ui.html", "dist/ui.js", "dist/ui.css"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"]
		}
	]
}
