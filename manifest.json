{
	"name": "Splitwise Sync for Monarch",
	"description": "Syncs Splitwise group expenses into Monarch accounts. All processing happens locally in your browser.",
	"version": "2.3",
	"manifest_version": 3,
	"minimum_chrome_version": "111",
	"icons": {
		"16": "dist/icons/16.png",
		"48": "dist/icons/48.png",
		"128": "dist/icons/128.png"
	},
	"permissions": ["storage"],
	"background": {
		"service_worker": "dist/background.js"
	},
	"content_scripts": [
		{
			"js": ["dist/fetch-interceptor.js"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"js": ["dist/content.js"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["dist/ui.html", "dist/ui.js", "dist/ui.css"],
			"matches": ["*://app.monarch.com/*", "*://secure.splitwise.com/*"]
		}
	]
}
